# Supabase - inserisci i valori del tuo progetto (https://app.supabase.com)
# Project URL -> Settings > API
VITE_SUPABASE_URL=
# anon / public key
VITE_SUPABASE_ANON_KEY=

# Unsplash - opzionale, abilita il suggerimento foto copertina nel form viaggio (1.5)
# Crea un'app gratuita ("Demo", 50 richieste/ora) su https://unsplash.com/developers
# e incolla qui la "Access Key". Se lasciato vuoto, il pulsante non compare.
VITE_UNSPLASH_ACCESS_KEY=